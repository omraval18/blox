--swiftversion 6.2
--indent 4
--maxwidth 110
--trailing-commas always
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--self remove
--ifdef no-indent
--disable wrapMultilineStatementBraces
--enable preferFinalClasses,redundantSelf,redundantType,sortImports,isEmpty,preferKeyPath,redundantProperty,blankLinesBetweenScopes
